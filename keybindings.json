    },
    {
        "key": "ctrl+i",
        "command": "-settings.action.toggleAiSearch",
        "when": "aiSettingResultsAvailable && inSettingsEditor"
    },
    {
        "key": "ctrl+i",
        "command": "-search.action.searchWithAI",
        "when": "hasAIResultProviderKey && searchViewletFocus"
    },
    {
        "key": "ctrl+i",
        "command": "cursorUp",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+u",
        "command": "cursorDown",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+k b",
        "command": "cursorHome",
        "when": "textInputFocus"
    }
]
